# ---------------------------------------------------------------------------
# tvbox-source-monitor environment template
# Copy to .env and fill in.  NEVER commit the filled .env.
# In GitHub Actions these come from Repository Secrets.
# ---------------------------------------------------------------------------

# GitHub API token used by the discovery adapter (repo + code search).
# Needs scopes: repo (public_repo is enough for search on public repos).
GH_TOKEN=

# Token used by GitHub Actions to commit the SQLite DB / dist back to the repo.
# In Actions this is the automatic GITHUB_TOKEN - do not set it locally.
GITHUB_TOKEN=

# --- Multi-region remote probe nodes (方案 B, optional in V1) --------------
PROBE_TOKEN_JP_01=
PROBE_SECRET_JP_01=
PROBE_TOKEN_HK_01=
PROBE_SECRET_HK_01=
PROBE_TOKEN_US_01=
PROBE_SECRET_US_01=

# --- Alert channels (all optional, disable in config/notifications.yaml) ---
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert sink: when set, the alert engine opens/closes GitHub Issues.
ALERT_GITHUB_REPO=

# --- Overrides -------------------------------------------------------------
# TVBOX_DB_PATH=data/monitor.db
# TVBOX_LOG_LEVEL=DEBUG
