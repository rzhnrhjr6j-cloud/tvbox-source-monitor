                                                                                <li><a target="_blank" rel="noopener noreferrer" href="https://1816929521.mshare.123pan.cn/123pan/iM8yVv-YUKD?notoken=1">点我进入起源新网盘</a></li>
                                                                                <li><a target="_blank" rel="noopener noreferrer" href="https://t.me/fanfanfx">点我进入官方频道</a></li>
                                                            </ul>
            </div>
        </section>
        <div class="footer">本站由 <a href="http://103.185.249.229" style="color:var(--brand);text-decoration:none;">导航云SaaS</a> 提供技术支持</div>
    </main>
    <script>
        // 雪花特效（默认 data-effect="none" 静默，如需启用雪花可在前端注入 config 时设置）
        (function () {
            var canvas = document.querySelector('.effect-canvas');
            var body = document.body;
            var snowFrame = 0;
            var snowCleanup = null;

            function snowCount(density) {
                var base = density === 'high' ? 110 : density === 'low' ? 36 : 70;
                return window.innerWidth < 520 ? Math.round(base * .55) : base;
            }

            function stopSnow() {
                body.setAttribute('data-effect', 'none');
                if (snowFrame) cancelAnimationFrame(snowFrame);
                snowFrame = 0;
                if (snowCleanup) snowCleanup();
                snowCleanup = null;
            }

            function startSnow(density) {
                if (!canvas) return;
                stopSnow();
                body.setAttribute('data-effect', 'snow');

                var ctx = canvas.getContext('2d');
                var width = 0;
                var height = 0;
                var flakes = [];

                function resetFlake(flake, firstRun) {
                    flake.x = Math.random() * width;
                    flake.y = firstRun ? Math.random() * height : -12;
                    flake.r = 1.2 + Math.random() * 3.6;
                    flake.speed = .45 + Math.random() * 1.35;
                    flake.drift = -.35 + Math.random() * .7;
                    flake.alpha = .45 + Math.random() * .45;
                }

                function resize() {
                    width = canvas.width = window.innerWidth;
                    height = canvas.height = window.innerHeight;
                    flakes = new Array(snowCount(density)).fill(0).map(function () {
                        var flake = {};
                        resetFlake(flake, true);
                        return flake;
                    });
                }

                function draw() {
                    ctx.clearRect(0, 0, width, height);
                    ctx.fillStyle = '#fff';
                    flakes.forEach(function (flake) {
                        ctx.globalAlpha = flake.alpha;
                        ctx.beginPath();
                        ctx.arc(flake.x, flake.y, flake.r, 0, Math.PI * 2);
                        ctx.fill();
                        flake.x += flake.drift;
                        flake.y += flake.speed;
                        if (flake.y > height + 12 || flake.x < -20 || flake.x > width + 20) {
                            resetFlake(flake, false);
                        }
                    });
                    ctx.globalAlpha = 1;
                    snowFrame = requestAnimationFrame(draw);
                }

                resize();
                window.addEventListener('resize', resize);
                snowCleanup = function () {
                    window.removeEventListener('resize', resize);
                    ctx.clearRect(0, 0, width, height);
                };
                draw();
            }

            // 暴露到全局，便于按需启用
            window.__theme3Snow = { start: startSnow, stop: stopSnow };
        })();
    </script>

<script>
(function(){
    var api = "/api.php?action=get_announcement&slug=15577";
    var cachedAnn = null;
    var annBtn = null;

    // 页面加载时自动检查公告 → 直接弹窗
    fetch(api).then(function(r){return r.json();}).then(function(d){
        if(!d.data || !d.data.enabled || !d.data.title) return;
        cachedAnn = d.data;
        showModal(cachedAnn);
        createFloatBtn();
    }).catch(function(){});

    function createFloatBtn(){
        if(annBtn) return;
        annBtn = document.createElement("div");
        annBtn.style.cssText="position:fixed;bottom:24px;right:24px;width:52px;height:52px;background:linear-gradient(135deg,#007AFF,#5856D6);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:99990;box-shadow:0 4px 20px rgba(0,122,255,0.35);transition:transform 0.2s;font-size:24px;color:#fff;";
        annBtn.innerHTML='📢';
        annBtn.title=cachedAnn.title;
        annBtn.onclick=function(){ showAnnouncement(); };
        annBtn.onmouseenter=function(){ annBtn.style.transform="scale(1.1)"; };
        annBtn.onmouseleave=function(){ annBtn.style.transform="scale(1)"; };
        document.body.appendChild(annBtn);
    }

    window.showAnnouncement = function(){
        if(cachedAnn && cachedAnn.enabled && cachedAnn.title){
            showModal(cachedAnn);
            return;
        }
        fetch(api).then(function(r){return r.json();}).then(function(d){
            if(!d.data || !d.data.enabled || !d.data.title) return;
            cachedAnn = d.data;
            showModal(cachedAnn);
            if(!annBtn) createFloatBtn();
        }).catch(function(){});
    };
    function showModal(data){
        var m=document.createElement("div");
        m.style.cssText="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.45);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px";
        m.innerHTML='<div style="background:rgba(255,255,255,0.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-radius:20px;padding:28px 24px;max-width:400px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.6)">'
            +'<h2 style="margin:0 0 18px;font-size:20px;font-weight:700;color:#1c1c1e;letter-spacing:-0.3px">'+data.title.replace(/</g,"&lt;")+'</h2>'
            +(data.image?'<img src="'+data.image+'" style="max-width:100%;max-height:300px;border-radius:12px;margin-bottom:18px;object-fit:contain" onerror="this.style.display=\'none\'">':'')
            +'<button style="background:#007AFF;color:#fff;border:none;padding:12px 48px;border-radius:12px;font-size:16px;font-weight:600;cursor:pointer;transition:background 0.2s" onmouseover="this.style.background=\'#0062CC\'" onmouseout="this.style.background=\'#007AFF\'" onclick="this.closest(\'div\').parentElement.remove()">我知道了</button>'
            +'</div>';
        document.body.appendChild(m);
        m.onclick=function(e){if(e.target===m) m.remove();};
    }

})();
</script></body>
</html>