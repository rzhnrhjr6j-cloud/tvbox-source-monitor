<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>起源官网</title>
    <meta name="description" content="起源官网 建议收藏备">
    <meta name="robots" content="index,follow">
    <meta name="keywords" content="起源官网,导航,收藏">
    <style>
        :root {
            color-scheme: light;
            --bg: #f5f6f7;
            --panel: #ffffff;
            --text: #1b1d21;
            --muted: #6b7280;
            --line: #dedfe3;
            --brand: #d92626;
            --brand-dark: #b91f1f;
            --cover-a: #22252b;
            --cover-b: #353941;
            --button-bg: #1b1d21;
            --button-text: #ffffff;
            --button-border: transparent;
            --glow-a: rgba(47, 111, 237, .10);
            --glow-b: rgba(217, 38, 38, .10);
            --shadow: 0 18px 50px rgba(21, 24, 31, .10);
        }

        body[data-theme="clean"] {
            --bg: #eef1f5;
            --panel: rgba(255, 255, 255, .94);
            --text: #20242a;
            --muted: #69727f;
            --line: #e2e6ec;
            --brand: #2f6fed;
            --brand-dark: #2457bd;
            --cover-a: #2f6fed;
            --cover-b: #6c8ff6;
            --button-bg: #ffffff;
            --button-text: #20242a;
            --button-border: #e2e6ec;
            --glow-a: rgba(47, 111, 237, .16);
            --glow-b: rgba(42, 184, 152, .10);
            --shadow: 0 22px 70px rgba(31, 45, 72, .16);
        }

        body[data-theme="ink"] {
            color-scheme: dark;
            --bg: #111317;
            --panel: #1a1d23;
            --text: #f3f4f6;
            --muted: #b4bac4;
            --line: #2d323b;
            --brand: #f04438;
            --brand-dark: #d92d20;
            --cover-a: #060708;
            --cover-b: #282d36;
            --button-bg: #f3f4f6;
            --button-text: #111317;
            --button-border: transparent;
            --glow-a: rgba(240, 68, 56, .16);
            --glow-b: rgba(255, 255, 255, .07);
            --shadow: 0 18px 50px rgba(0, 0, 0, .28);
        }

        body[data-theme="warm"] {
            --bg: #fff7ef;
            --panel: #fffdf9;
            --text: #2d211b;
            --muted: #806a5c;
            --line: #ead9c9;
            --brand: #c44a2c;
            --brand-dark: #9f3822;
            --cover-a: #5a271a;
            --cover-b: #d96b3c;
            --button-bg: #2d211b;
            --button-text: #fffaf5;
            --button-border: transparent;
            --glow-a: rgba(196, 74, 44, .12);
            --glow-b: rgba(255, 184, 107, .16);
        }

        body[data-theme="mint"] {
            --bg: #eef8f3;
            --panel: #ffffff;
            --text: #153128;
            --muted: #5c766c;
            --line: #cde2d8;
            --brand: #167a5b;
            --brand-dark: #106147;
            --cover-a: #123d31;
            --cover-b: #1f9b72;
            --button-bg: #153128;
            --button-text: #ffffff;
            --button-border: transparent;
            --glow-a: rgba(22, 122, 91, .16);
            --glow-b: rgba(118, 211, 174, .14);
        }

        body[data-theme="night"] {
            color-scheme: dark;
            --bg: #101728;
            --panel: #182236;
            --text: #f7f7fb;
            --muted: #b8c0d0;
            --line: #2b3851;
            --brand: #d6a84f;
            --brand-dark: #b98b36;
            --cover-a: #07101f;
            --cover-b: #263b5f;
            --button-bg: #d6a84f;
            --button-text: #111827;
            --button-border: transparent;
            --glow-a: rgba(214, 168, 79, .15);
            --glow-b: rgba(80, 125, 190, .14);
            --shadow: 0 18px 60px rgba(0, 0, 0, .32);
        }

        body[data-theme="ocean"] {
            --bg: #edf7fb;
            --panel: rgba(255, 255, 255, .95);
            --text: #102b3d;
            --muted: #5c7280;
            --line: #d4e7ef;
            --brand: #0f88b8;
            --brand-dark: #0b6d94;
            --cover-a: #0b5f89;
            --cover-b: #23a6d5;
            --button-bg: #ffffff;
            --button-text: #102b3d;
            --button-border: #d4e7ef;
            --glow-a: rgba(35, 166, 213, .18);
            --glow-b: rgba(30, 196, 170, .13);
            --shadow: 0 22px 70px rgba(15, 88, 123, .14);
        }

        body[data-theme="rose"] {
            --bg: #fff3f5;
            --panel: #fffefe;
            --text: #341923;
            --muted: #85616c;
            --line: #f0d4dc;
            --brand: #d63d67;
            --brand-dark: #ad2f51;
            --cover-a: #8f2440;
            --cover-b: #e7678b;
            --button-bg: #ffffff;
            --button-text: #341923;
            --button-border: #f0d4dc;
            --glow-a: rgba(214, 61, 103, .16);
            --glow-b: rgba(255, 188, 197, .22);
            --shadow: 0 22px 70px rgba(130, 35, 63, .13);
        }

        body[data-theme="graphite"] {
            color-scheme: dark;
            --bg: #15181d;
            --panel: #20242b;
            --text: #f5f7fa;
            --muted: #aeb6c2;
            --line: #343a44;
            --brand: #7aa7ff;
            --brand-dark: #5e86d8;
            --cover-a: #11151c;
            --cover-b: #3a4658;
            --button-bg: #2a3039;
            --button-text: #f5f7fa;
            --button-border: #3b4350;
            --glow-a: rgba(122, 167, 255, .16);
            --glow-b: rgba(255, 255, 255, .06);
            --shadow: 0 22px 70px rgba(0, 0, 0, .34);
        }

        body[data-theme="frost"] {
            --bg: #f3f8ff;
            --panel: rgba(255, 255, 255, .86);
            --text: #162236;
            --muted: #66758b;
            --line: #dce8f7;
            --brand: #4d82d9;
            --brand-dark: #3968b1;
            --cover-a: #6d9fe7;
            --cover-b: #d8e8ff;
            --button-bg: rgba(255, 255, 255, .88);
            --button-text: #162236;
            --button-border: #dce8f7;
            --glow-a: rgba(109, 159, 231, .18);
            --glow-b: rgba(255, 255, 255, .55);
            --shadow: 0 22px 70px rgba(59, 96, 140, .14);
        }

        body[data-theme="ruby"] {
            --bg: #fff5f2;
            --panel: #fffdfc;
            --text: #301d18;
            --muted: #7c645d;
            --line: #efd8d0;
            --brand: #c83232;
            --brand-dark: #a82727;
            --cover-a: #6f1d1d;
            --cover-b: #d94b3d;
            --button-bg: #301d18;
            --button-text: #ffffff;
            --button-border: transparent;
            --glow-a: rgba(200, 50, 50, .14);
            --glow-b: rgba(255, 150, 120, .16);
            --shadow: 0 22px 70px rgba(125, 47, 37, .13);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", Arial, sans-serif;
            background:
                radial-gradient(circle at 18% 10%, var(--glow-a), transparent 30vw),
                radial-gradient(circle at 84% 20%, var(--glow-b), transparent 26vw),
                var(--bg);
            color: var(--text);
            transition: background .18s ease, color .18s ease;
        }

        .effect-canvas {
            position: fixed;
            inset: 0;
            display: none;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 5;
        }

        body[data-effect="snow"] .effect-canvas {
            display: block;
        }

        .page {
            position: relative;
            z-index: 10;
            width: min(92vw, 500px);
            margin: 0 auto;
            min-height: 100vh;
            padding: 40px 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .shop-card {
            width: 100%;
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: var(--shadow);
            overflow: visible;
        }

        .cover {
            position: relative;
            min-height: 116px;
            background: linear-gradient(135deg, var(--cover-a) 0%, var(--cover-b) 100%);
            border-bottom: 4px solid var(--brand);
            border-radius: 20px 20px 0 0;
            overflow: hidden;
        }

        .cover::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(120deg, rgba(255, 255, 255, .22), transparent 36%),
                radial-gradient(circle at 82% 22%, rgba(255, 255, 255, .18), transparent 24%);
        }

        .profile {
            position: relative;
            z-index: 2;
            padding: 0 28px 30px;
            text-align: center;
        }

        .avatar-wrap {
            width: 124px;
            height: 124px;
            margin: -64px auto 18px;
            border-radius: 50%;
            border: 5px solid var(--panel);
            background: #eceef2;
            overflow: hidden;
            position: relative;
            z-index: 3;
            box-shadow: 0 10px 28px rgba(21, 24, 31, .18);
        }

        .avatar-wrap img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        h1 {
            margin: 0;
            font-size: 26px;
            line-height: 1.28;
            font-weight: 700;
            letter-spacing: 0;
            color: var(--text);
        }

        .hint {
            margin: 9px 0 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.7;
            white-space: pre-wrap;
        }

        .links {
            list-style: none;
            margin: 24px 0 0;
            padding: 0;
            display: grid;
            gap: 12px;
        }

        .links li {
            margin: 0;
            padding: 0;
        }

        .links a {
            display: block;
            width: 100%;
            padding: 15px 18px;
            border-radius: 12px;
            background: var(--button-bg);
            color: var(--button-text);
            text-decoration: none;
            font-size: 16px;
            font-weight: 700;
            line-height: 1.2;
            border: 1px solid var(--button-border);
            box-shadow: 0 8px 22px rgba(21, 24, 31, .06);
            transition: background .16s ease, color .16s ease, border-color .16s ease, transform .16s ease, box-shadow .16s ease;
        }

        .links a:hover,
        .links a:focus-visible {
            background: var(--brand);
            color: #fff;
            border-color: var(--brand);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(21, 24, 31, .12);
            outline: none;
        }

        body[data-theme="clean"] .shop-card,
        body[data-theme="frost"] .shop-card {
            backdrop-filter: blur(16px);
        }

        body[data-theme="clean"] .cover {
            min-height: 92px;
            border-bottom: 0;
        }

        body[data-theme="clean"] .avatar-wrap {
            width: 118px;
            height: 118px;
            margin-top: -50px;
            box-shadow: 0 14px 34px rgba(47, 111, 237, .22);
        }

        body[data-theme="clean"] .links {
            gap: 10px;
        }

        body[data-theme="clean"] .links a {
            box-shadow: 0 8px 22px rgba(31, 45, 72, .07);
        }

        .footer {
            margin-top: 18px;
            text-align: center;
            color: var(--muted);
            font-size: 12px;
        }

        @media (max-width: 420px) {
            .page {
                width: min(94vw, 420px);
                min-height: auto;
                padding-top: 28px;
                padding-bottom: 40px;
                justify-content: flex-start;
            }

            .profile {
                padding: 0 18px 24px;
            }

            h1 {
                font-size: 22px;
            }

            .links a {
                padding: 13px 15px;
            }
        }
    </style>
</head>
<body data-theme="clean" data-effect="none">
    <canvas class="effect-canvas" aria-hidden="true"></canvas>
    <main class="page">
        <section class="shop-card" aria-label="店铺入口">
            <div class="cover"></div>
            <div class="profile">
                <div class="avatar-wrap">
                    <img src="themes/theme3/tx.jpg" alt="店铺图片" onerror="this.style.display='none'">
                </div>
                <h1>起源官网</h1>
                <p class="hint">起源官网 建议收藏备用</p>
                <ul class="links">
