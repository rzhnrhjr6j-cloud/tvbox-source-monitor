<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FongMi - 影视APP - 下载</title>
<style>
  :root {
    --text: #f4f7ff;
    --text-dim: rgba(244, 247, 255, 0.72);
    --glass: rgba(255, 255, 255, 0.12);
    --glass-strong: rgba(255, 255, 255, 0.2);
    --glass-border: rgba(255, 255, 255, 0.28);
    --accent: #7dd3fc;
    --warn: #fde68a;
    --shadow: 0 8px 32px rgba(10, 14, 50, 0.35);
  }

  * { box-sizing: border-box; }

  html, body { margin: 0; min-height: 100%; }

  body {
    font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Noto Sans SC", "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    line-height: 1.7;
    background: #1b1f4b;
    background-image:
      radial-gradient(60vmax 60vmax at 10% 10%, #5b4bdb 0%, transparent 60%),
      radial-gradient(55vmax 55vmax at 90% 20%, #0ea5a4 0%, transparent 60%),
      radial-gradient(60vmax 60vmax at 50% 100%, #d946a8 0%, transparent 60%);
    background-attachment: fixed;
    padding: 48px 16px 64px;
  }

  .wrap {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h1 {
    margin: 0 0 4px;
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-align: center;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.25);
  }

  .glass {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 22px 24px;
    box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass { background: rgba(40, 44, 100, 0.85); }
  }

  .glass h2 {
    margin: 0 0 12px;
    font-size: 1.05rem;
    font-weight: 600;
  }

  ul { margin: 0; padding: 0; list-style: none; }

  .glass li { padding: 3px 0; color: var(--text-dim); }
  .glass li::marker { content: ""; }

  .tips li {
    position: relative;
    padding-left: 18px;
  }
  .tips li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.85em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--warn);
  }

  .config-row {
    display: flex;
    align-items: stretch;
    gap: 8px;
    margin: 6px 0;
  }

  .copy-btn {
    flex: none;
    padding: 0 18px;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    background: var(--glass-strong);
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-btn:hover { background: rgba(255, 255, 255, 0.32); }
  .copy-btn.done {
    background: var(--accent);
    border-color: var(--accent);
    color: #0b2a3a;
    font-weight: 600;
  }

  .config {
    display: block;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid var(--glass-border);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.95rem;
    word-break: break-all;
    user-select: all;
  }

  .path {
    color: var(--text);
    font-weight: 600;
  }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .links a {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--glass-strong);
    border: 1px solid var(--glass-border);
    color: var(--text);
    font-size: 0.95rem;
  }
  .links a:hover { background: rgba(255, 255, 255, 0.3); text-decoration: none; }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--glass-border);
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .downloads {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .dl {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border-radius: 16px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    color: var(--text);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transition: background 0.2s, transform 0.2s;
  }
  .dl:hover {
    background: rgba(255, 255, 255, 0.24);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .dl .name { font-weight: 600; }
  .dl .hint { font-size: 0.85rem; color: var(--text-dim); }
  .dl.rec { border-color: rgba(125, 211, 252, 0.7); background: rgba(125, 211, 252, 0.16); }
  .dl.rec .name::after {
    content: "推荐";
    margin-left: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #0b2a3a;
    font-size: 0.75rem;
    font-weight: 700;
    vertical-align: 1px;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 520px) {
    body { padding: 32px 12px 48px; }
    .glass { padding: 18px 18px; border-radius: 18px; }
    .downloads { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dl { transition: none; }
    .dl:hover { transform: none; }
  }
</style>
</head>
<body>
<div class="wrap">
  <h1>FongMi - 影视APP - 下载</h1>

  <section class="glass">
