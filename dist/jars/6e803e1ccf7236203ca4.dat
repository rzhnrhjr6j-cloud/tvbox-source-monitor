          <span class="config" id="config-url">https://tv.菜妮丝.top</span>
          <button type="button" class="copy-btn" id="copy-btn">复制</button>
        </div>
      </li>
      <li>到 <span class="path">设置</span> - <span class="path">点播</span> - 使用配置接口</li>
    </ul>
    <div class="links">
      <a target="_blank" rel="noopener" href="https://ys.菜妮丝.top">在线观影</a>
      <a target="_blank" rel="noopener" href="https://m.172.org.cn/ProductEn/Index/f59a02b8a031c5c7">领取流量卡</a>
    </div>
  </section>

  <section class="glass">
