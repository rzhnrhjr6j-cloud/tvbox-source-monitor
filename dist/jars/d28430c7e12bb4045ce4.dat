	<html>  
  <style>  
    /* 弹出框的样式 */  
    .modal {  
      display: none; /* 默认隐藏 */  
      position: fixed; /* 固定定位 */  
      z-index: 9999; /* 层级最高 */  
      left: 0;  
      top: 0;  
      width: 100%; /* 全屏宽度 */  
      height: 100%; /* 全屏高度 */  
      overflow: auto; /* 启用滚动条 */  
      background-color: rgb(0,0,0); /* 黑色背景 */  
      background-color: rgba(0,0,0,0.4); /* 黑色背景，半透明 */  
    }  
  
    /* 弹窗内容的样式 */  
    .modal-content {  
      background-color: rgba(0,0,0,0);  
      margin: 15% auto; /* 15% 从顶部开始，居中 */  
      padding: 20px;  

      width: 80%; /* 弹窗宽度 */  
      max-width: 600px; /* 最大宽度 */  
    }  
  
    /* 图片样式 */  
    .modal-content img {  
      width: 100%;  
      height: 100%;  
    }  
  
    /* 关闭按钮的样式 */  
    .close {  
      color: #aaaaaa;  
      float: right;  
      font-size: 28px;  
      font-weight: bold;  
    }  
  
    .close:hover,  
    .close:focus {  
      color: #000;  
      text-decoration: none;  
      cursor: pointer;  
    }  
  </style>  
</head>  
<body onload="showPopup()">  
  
<!-- 弹出框结构 -->  
<div id="myModal" class="modal">  
  <div class="modal-content">  
    <span class="close" onclick="closePopup()">&times;</span>  
    <img src="images/qrcode.png" alt="弹窗图片">  
  </div>  
</div>  
  
<script>  
// 显示弹窗的函数  
function showPopup() {  
  var modal = document.getElementById("myModal");  
  modal.style.display = "block";  
}  
  
// 关闭弹窗的函数  
function closePopup() {  
  var modal = document.getElementById("myModal");  
  modal.style.display = "none";  
}  
  
// 点击弹窗以外的地方也可以关闭弹窗  
window.onclick = function(event) {  
  if (event.target == document.getElementById("myModal")) {  
    closePopup();  
  }  
}  
</script>  
